+ * before it under the same version string (third_party/dxvk-texbem.patch: texbem's matrix). */
+#define DXVK_SHADER_CACHE_VERSION DXVK_VERSION "+texbem"
+
 namespace dxvk {
 
   DxvkShaderCache::Instance DxvkShaderCache::s_instance;
