+  void D3D9DeviceEx::SetLiveSamplerAnisotropy(int32_t Anisotropy) {
+    D3D9DeviceLock lock = LockDevice();
+
+    if (m_d3d9Options.samplerAnisotropy == Anisotropy)
+      return;
+
+    m_d3d9Options.samplerAnisotropy = Anisotropy;
+    // every sampler made again at its next use, with the new anisotropy
+    m_textureSlotTracking.samplerStateDirty |= (1u << caps::MaxTextures) - 1u;
+  }
+
+
+  void D3D9DeviceEx::SetLiveShadowFilter(int32_t Filter) {
+    D3D9DeviceLock lock = LockDevice();
+    // (shaders created from now on: the runtime makes the ones it needs again)
+    m_d3d9Options.shadowFilter = Filter;
+    m_shaderOptions.shadowFilter = uint8_t(std::clamp(Filter, 0, 7));
+  }
+
